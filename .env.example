# Interface: "mock" (padrao) usa as skills deterministicas no proprio navegador.
# "http" faz a interface chamar o servidor em server/index.js.
VITE_AI_MODE=mock

# Servidor de skills. Sem estas tres variaveis o servidor responde com a
# implementacao deterministica, entao ele sobe e funciona sem credencial.
AI_API_URL=
AI_API_KEY=
AI_MODEL=
AI_TIMEOUT_MS=30000
PORT=8787
